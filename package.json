{
    "name": "react-if-directive",
    "version": "1.0.0",
    "description": "React conditional rendering directives (r-if, r-else-if, r-else) with support for Vite, Next.js, Webpack, and Babel",
    "author": "",
    "license": "MIT",
    "private": false,
    "keywords": [
        "react",
        "vite",
        "nextjs",
        "webpack",
        "babel",
        "plugin",
        "conditional",
        "rendering",
        "directives",
        "if-else",
        "jsx",
        "eslint"
    ],
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./vite": {
            "import": {
                "types": "./dist/vite.d.ts",
                "default": "./dist/vite.js"
            },
            "require": {
                "types": "./dist/vite.d.cts",
                "default": "./dist/vite.cjs"
            }
        },
        "./eslint": {
            "import": {
                "types": "./dist/eslint.d.ts",
                "default": "./dist/eslint.js"
            },
            "require": {
                "types": "./dist/eslint.d.cts",
                "default": "./dist/eslint.cjs"
            }
        },
        "./babel": {
            "import": {
                "types": "./dist/babel.d.ts",
                "default": "./dist/babel.js"
            },
            "require": {
                "types": "./dist/babel.d.cts",
                "default": "./dist/babel.cjs"
            }
        },
        "./nextjs": {
            "import": {
                "types": "./dist/nextjs.d.ts",
                "default": "./dist/nextjs.js"
            },
            "require": {
                "types": "./dist/nextjs.d.cts",
                "default": "./dist/nextjs.cjs"
            }
        },
        "./types": {
            "types": "./src/jsx.d.ts"
        }
    },
    "files": [
        "dist",
        "src/jsx.d.ts",
        "README.md"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "typecheck": "tsc --noEmit",
        "lint": "eslint src",
        "prepublishOnly": "npm run build && npm run test"
    },
    "peerDependencies": {
        "react": ">=17.0.0",
        "vite": ">=4.0.0",
        "eslint": ">=8.0.0",
        "next": ">=12.0.0"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": false
        },
        "vite": {
            "optional": true
        },
        "eslint": {
            "optional": true
        },
        "next": {
            "optional": true
        }
    },
    "dependencies": {
        "@babel/generator": "^7.24.0",
        "@babel/parser": "^7.24.0",
        "@babel/traverse": "^7.24.0",
        "@babel/types": "^7.24.0"
    },
    "devDependencies": {
        "@babel/core": "^7.24.0",
        "@types/babel__generator": "^7.6.8",
        "@types/babel__traverse": "^7.20.5",
        "@types/node": "^20.11.0",
        "eslint": "^9.0.0",
        "next": "^14.0.0",
        "react": "^18.0.0",
        "tsup": "^8.0.0",
        "typescript": "^5.3.0",
        "vite": "^5.0.0",
        "vitest": "^2.0.0"
    },
    "repository": {
        "type": "git",
        "url": ""
    },
    "bugs": {
        "url": ""
    },
    "homepage": ""
}
